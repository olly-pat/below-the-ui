{
  "name": "below-the-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript tests that check what the UI shows against what the system actually stored",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --no-warnings server/main.ts",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "faults": "node --no-warnings scripts/verify-faults.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
